{
  "name": "app",
  "version": "1.0.0",
  "private": true,
  "description": "Tranche shopper app (Expo + expo-router).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"app/**/*.tsx\" \"src/**/*.{ts,tsx}\"",
    "export": "expo export --platform android --output-dir dist",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@tranche/shared": "workspace:*",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.21",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.57.1"
  }
