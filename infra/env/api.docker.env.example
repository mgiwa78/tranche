# ===== Used by infra/docker/docker-compose.yml (copy to api.docker.env) =====
NODE_ENV=production
PORT=4000
APP_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:3000
DB_HOST=postgres
DB_PORT=5432
DB_NAME=tranche
DB_USERNAME=postgres
DB_PASSWORD=postgres
REDIS_HOST=redis
REDIS_PORT=6379
# Generate with: pnpm --filter api keys:generate
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ENCRYPTION_KEY=
# Paystack test keys (required when NODE_ENV=production)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
QUEUE_DASHBOARD_USER=admin
QUEUE_DASHBOARD_PASSWORD=change-me
