# ===== Render (set in the dashboard; render.yaml wires DB/Redis and generated secrets) =====
# Wired by render.yaml: DATABASE_URL, REDIS_URL, ENCRYPTION_KEY, QUEUE_DASHBOARD_PASSWORD
NODE_ENV=production
APP_ROLE=all
APP_URL=https://tranche-api.onrender.com
ALLOWED_ORIGINS=https://tranche.vercel.app,https://*.vercel.app
SEED_ON_BOOT=demo
# Secrets you paste in (sync: false)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
EXPO_ACCESS_TOKEN=
RESEND_API_KEY=
SEED_ADMIN_PASSWORD=
