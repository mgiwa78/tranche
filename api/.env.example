# ===== App =====
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
# api = HTTP only, worker = BullMQ processors only, all = both (single Render service)
APP_ROLE=all
SERVICE_NAME=tranche-api
SERVICE_VERSION=1.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# ===== Database (DATABASE_URL wins when set, e.g. on Render) =====
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tranche
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_SYNCHRONIZE=false

# ===== Redis (REDIS_URL wins when set) =====
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=tranche
REDIS_TTL=3600

# ===== JWT (RS256, base64 PEM; generate with `pnpm --filter api keys:generate`) =====
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ===== Encryption at rest (64 hex chars) =====
ENCRYPTION_KEY=

# ===== Rate limiting =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1500
RATE_LIMIT_MULTIPLIER=1

# ===== Logging =====
LOG_LEVEL=info
ENABLE_FILE_LOGGING=false

# ===== Paystack (test keys from dashboard.paystack.com; empty = built-in fake checkout) =====
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Leave empty to use this api's /api/v1/payments/return, which redirects into the app
PAYSTACK_CALLBACK_URL=
APP_RETURN_URL=tranche://checkout/callback

# ===== Push / email =====
EXPO_ACCESS_TOKEN=
RESEND_API_KEY=
SMTP_FROM=Tranche <no-reply@tranche.ng>

# ===== Queues =====
QUEUE_ATTEMPTS=3
QUEUE_REMOVE_ON_COMPLETE=500
QUEUE_REMOVE_ON_FAIL=1000
QUEUE_INLINE=false
QUEUE_DASHBOARD_USER=admin
QUEUE_DASHBOARD_PASSWORD=
REMINDERS_CRON=0 8 * * *
CHARGES_CRON=0 * * * *
OVERDUE_CRON=30 0 * * *
SCHEDULE_TIMEZONE=Africa/Lagos

# ===== Seed =====
SEED_ADMIN_PASSWORD=Tranche123!
