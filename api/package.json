{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "description": "Tranche API - NestJS, PostgreSQL (TypeORM), Redis, BullMQ, Paystack.",
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "cross-env APP_ROLE=worker node dist/main.js",
    "dev": "nest start --watch",
    "typeorm": "node scripts/typeorm-cli.js",
    "db:migrate": "node scripts/typeorm-cli.js migration:run -d src/config/data-source.ts",
    "db:revert": "node scripts/typeorm-cli.js migration:revert -d src/config/data-source.ts",
    "db:generate": "node scripts/typeorm-cli.js migration:generate src/database/migrations/Migration -d src/config/data-source.ts",
    "db:check": "node scripts/typeorm-cli.js migration:generate src/database/migrations/Drift --check --dryrun -d src/config/data-source.ts",
    "db:migrate:prod": "typeorm migration:run -d dist/config/data-source.js",
    "seed": "ts-node -r tsconfig-paths/register src/database/seeders/seed-runner.ts",
    "seed:prod": "node dist/database/seeders/seed-runner.js",
    "keys:generate": "node scripts/generate-keys.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.cjs --coverage",
    "test:int": "jest --config jest.integration.config.cjs --coverage",
    "test:all": "jest --config jest.all.config.cjs --coverage --runInBand"
  },
  "dependencies": {
    "@bull-board/api": "^6.21.3",
    "@bull-board/express": "^6.21.3",
    "@faker-js/faker": "^9.9.0",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/typeorm": "^11.0.3",
    "@tranche/shared": "workspace:*",
    "axios": "^1.13.4",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.5",
    "compression": "^1.8.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "expo-server-sdk": "^3.15.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "pg": "^8.18.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.9.1",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "globals": "^17.6.0",
    "jest": "^30.2.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1"
  }
}
